flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        Users([Operators and<br/>log collectors]):::edge
        CLI["CLI<br/>parse, detect, stream"]:::edge
        HTTP["HTTP service<br/>ingest, score"]:::core
        Limits["Request limits<br/>size, lines"]:::control
        Users --> CLI ~~~ HTTP --> Limits
    end

    subgraph Parsing["Parsing (Rust core)"]
        direction TB
        Formats["Formats, masks<br/>LogPAI settings"]:::control
        Drain["Drain tree<br/>parallel chunks"]:::core
        Reference["Python reference<br/>exact parity"]:::core
        Templates[("Template store")]:::data
        Formats --> Drain --> Templates ~~~ Reference
    end

    subgraph Detection["Detection"]
        direction TB
        Features["Sessions, windows<br/>event counts"]:::core
        Count["PCA, invariants<br/>LogCluster, iForest"]:::core
        Neural["DeepLog LSTM<br/>transformer"]:::core
        Monitor["Stream monitor<br/>sessionize, score"]:::core
        Changes["Change points<br/>CUSUM, BOCPD"]:::core
        Features --> Count ~~~ Neural ~~~ Monitor ~~~ Changes
    end

    subgraph Outputs["Outputs and evaluation"]
        direction TB
        Alerts["Alerts<br/>sessions, rates"]:::obs
        Metrics["Metrics<br/>Prometheus text"]:::obs
        Bench["Benchmarks<br/>GA, F1, cover"]:::obs
        Datasets[("Loghub, HDFS, BGL<br/>TCPD")]:::data
        Alerts ~~~ Metrics ~~~ Datasets --> Bench
    end

    Interfaces -->|lines| Parsing
    Parsing -->|event ids| Detection
    Detection -->|scores| Outputs
